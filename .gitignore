# Allowlist: ignore everything, then unignore intended project files.
*
!*/
!.gitignore
!.gitattributes
!README.md
!LICENSE
!*.md
!*.py
!*.ts
!*.js
!*.json
!*.toml
!*.yaml
!*.yml
!*.sh
!*.service
!*.plist
!*.txt
!*.timer
!*.conf
!Dockerfile
!.env.example
!.githooks/*
!.github/**

# Never commit secrets, credentials, campaign data, transcripts or local names.
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
data/
notes/
transcripts/
logs/
*.log
node_modules/
.venv/
__pycache__/
*.egg-info/
build/
dist/
.pytest_cache/
.claude/
# Local-only files that hold real names, real questions and exports.
.privacy-denylist*
!.privacy-denylist.example
eval-questions*.local.*
Analecta-export/
export/
