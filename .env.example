# Copy to .env (untracked) and fill in. Never commit the real file.
# On the server, the systemd unit reads it from /etc/analecta/analecta.env.

# --- Discord (create the application yourself in the developer portal) ---
DISCORD_TOKEN=replace-with-bot-token
# Where the bot answers: a comma-separated list of server_id:channel_id pairs. Each channel must belong to the
# server written before it. It answers in those channels (and threads directly under them) and ignores every
# other channel, every other server and DMs. Example with two servers:
DISCORD_CHANNELS=replace-with-server-id:replace-with-channel-id,replace-with-second-server-id:replace-with-second-channel-id
# Older single-pair form, still supported (added to the list above if both are set). Both lines are required together:
# DISCORD_GUILD_ID=replace-with-server-id
# DISCORD_CHANNEL_ID=replace-with-channel-id

# --- Model provider (OpenAI only for now; the agent loop is provider-neutral) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-openai-key
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=low
LLM_MAX_TOOL_TURNS=8

# --- Campaign notes (the Syncthing receive-only folder on the server) ---
NOTES_DIR=/srv/analecta/notes

# --- Table corrections and the misread list (written by the bot; never inside NOTES_DIR) ---
# Holds corrections.md and misreads.md. Default if unset: /srv/analecta/corrections. This is the folder Syncthing
# sends (send-only) to the Mac for review. The bot refuses to start if it overlaps NOTES_DIR.
# CORRECTIONS_DIR=/srv/analecta/corrections

# --- Archives of Nethys rules lookup ---
AON_ENABLED=true
AON_CACHE_SECONDS=900
AON_MIN_INTERVAL_SECONDS=2
AON_USER_AGENT=analecta-discord-bot

# --- Cost and abuse guards ---
USER_COOLDOWN_SECONDS=20
DAILY_QUESTION_LIMIT=150

# --- Who runs this bot (optional) ---
# Your name, shown in the help text and the pinned note ("Analecta is run by ..."). Leave unset to say nothing.
# BOT_OWNER=replace-with-your-name

# --- Mac export script (not used by the bot) ---
ANALECTA_SOURCE_DIR=/path/to/campaign-notes-folder
ANALECTA_EXPORT_DIR=~/Analecta-export
